# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

# Icons are Nerd Font glyphs, coloured with pango markup.

general {
        colors = true
        markup = "pango"
        interval = 1
        color_good = "#989898"
        color_degraded = "#cc8100"
        color_bad = "#be2422"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "memory"
order += "volume master"
order += "tztime local"

volume master {
  device = "default"
  mixer = "Master"
  mixer_idx = 0
  format = "<span foreground='#7aa2f7'>󰕾</span> %volume"
  format_muted = "<span foreground='#be2422'>󰖁</span> mute"
}

wireless _first_ {
        format_up = "<span foreground='#7aa2f7'>󰖩</span> %essid %quality"
        format_down = "<span foreground='#be2422'>󰖪</span> down"
}

ethernet _first_ {
        format_up = "<span foreground='#7aa2f7'>󰈀</span> %speed"
        format_down = "<span foreground='#be2422'>󰈀</span> down"
}

memory {
        format = "<span foreground='#7aa2f7'>󰍛</span> %used/%available"
        threshold_degraded = "1G"
        format_degraded = "<span foreground='#8c7f22'>󰍛</span> %available left"
}

tztime local {
        format = "<span foreground='#7aa2f7'>󰥔</span> <span weight='bold'>%H:%M:%S</span>  <span foreground='#7aa2f7'>󰃭</span> %d/%m/%Y "
}

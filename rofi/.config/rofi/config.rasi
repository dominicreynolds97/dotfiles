configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Adwaita";
    font: "JetBrainsMono Nerd Font 11";
    display-drun: "";
    display-run: "";
    display-window: "";
    drun-display-format: "{name}";
}

// Start from an empty theme so only the styles below apply
@theme "/dev/null"

* {
    // Same palette as polybar and the i3 title colours
    bg:       #01122bcc;
    bg-input: #ffffff0d;
    selected: #012a63;
    fg:       #c0caf5;
    fg-sel:   #c4ddff;
    dim:      #565f89;
    accent:   #7aa2f7;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 600px;
    padding: 12px;
    border-radius: 15px;
    background-color: @bg;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    background-color: @bg-input;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @dim;
    cursor: text;
}

listview {
    lines: 8;
    fixed-height: false;
    scrollbar: false;
    spacing: 4px;
}

element {
    padding: 6px 12px;
    spacing: 10px;
    border-radius: 8px;
    cursor: pointer;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg-sel;
}

element-icon {
    size: 20px;
    cursor: inherit;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    cursor: inherit;
}
